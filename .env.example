ANTHROPIC_API_KEY=sk-ant-...

# Gmail multi-account
# Comma-separated account names. For each name, creds expected at:
#   creds/{name}_credentials.json   (downloaded from Google Cloud)
#   creds/{name}_token.json         (auto-created on first auth)
# Two accounts: GMAIL_ACCOUNTS=personal,work
# Slack cards show "📬 account" tags automatically when 2+ accounts configured.
GMAIL_ACCOUNTS=personal
GMAIL_FETCH_LIMIT=50
GMAIL_DB_PATH=./mail_agent.db

# Slack — required for digest/respond delivery and Mark-read buttons.
# Socket Mode: no public URL needed.
SLACK_BOT_TOKEN=              # xoxb-… Bot User OAuth Token
SLACK_APP_TOKEN=              # xapp-… App-Level Token (connections:write scope)
SLACK_USER_ID=                # U… your Slack member ID (Profile → ⋯ → Copy member ID)

# Models, confidence thresholds, and NL rules live in config/rules.yaml
# (see the `llm:` block) — not configured via env.
